APP_NAME=OtherSide API
ENV=local
DEBUG=true

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALG=HS256
# Lifetime of a session without activity: every /auth/refresh rotates the token and
# restarts this clock. Logout, password change and admin block revoke sessions early.
REFRESH_TOKEN_EXPIRE_DAYS=30

# Argon2id password hashing (OWASP baseline: m=19 MiB, t=2, p=1; production refuses less).
# Raising them is safe: existing hashes (incl. legacy bcrypt) are upgraded on next login.
PASSWORD_HASH_TIME_COST=2
PASSWORD_HASH_MEMORY_COST_KIB=19456
PASSWORD_HASH_PARALLELISM=1
# Concurrent hashes per process; each needs PASSWORD_HASH_MEMORY_COST_KIB of RAM.
PASSWORD_HASH_MAX_CONCURRENCY=4

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/app
# Per-process SQLAlchemy pool. If UVICORN_WORKERS > 1, each worker gets its own pool of this
# size, so total DB connections ~= UVICORN_WORKERS * (DB_POOL_SIZE + DB_MAX_OVERFLOW).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
CORS_ORIGINS=["*"]

# uvicorn worker processes (docker-compose.prod.yml). Each worker runs the in-memory rate
# limiter independently, so login/register/contact limits are effectively multiplied by this
# number until the limiter is backed by Redis — keep this modest (2-4) until that's in place.
UVICORN_WORKERS=2

# Initial admin (created once on API startup after migrations; min 12 chars)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now-12

ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_IS_TEST=true
ROBOKASSA_PAYMENT_URL=https://auth.robokassa.ru/Merchant/Index.aspx

# Email verification codes sent via SMTP (Selectel Email Service by default).
# See README.md "Настройка email-верификации (Selectel)" for the full setup guide.
SMTP_HOST=smtp.mail.selcloud.ru
SMTP_PORT=1127
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@otherside-inc.ru
SMTP_FROM_NAME=OtherSide
SMTP_USE_TLS=true
SITE_URL=https://otherside-inc.ru
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# Rate limits (requests per window in seconds)
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_CONTACT_REQUESTS=5
RATE_LIMIT_CONTACT_WINDOW_SECONDS=300
RATE_LIMIT_WEBHOOK_REQUESTS=100
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60

# Monitoring (docker-compose.prod.yml: prometheus/grafana/node-exporter/cadvisor)
GRAFANA_ADMIN_PASSWORD=change-me-now

# Production checklist (ENV=production):
# - SECRET_KEY: strong unique value
# - PASSWORD_HASH_*: at least the defaults above (enforced)
# - DEBUG=false
# - CORS_ORIGINS: explicit domains only (no *)
# - ROBOKASSA_*: all credentials set, ROBOKASSA_IS_TEST=false
# - SMTP_HOST/SMTP_USERNAME/SMTP_PASSWORD/SMTP_FROM_EMAIL: all set (required, or registration
#   emails won't send — see README.md "Настройка email-верификации (Selectel)")
# - Remove BOOTSTRAP_ADMIN_* after first admin is created
# - OpenAPI docs are disabled automatically when ENV != local
# - GRAFANA_ADMIN_PASSWORD: strong unique value (Grafana is only reachable via SSH tunnel,
#   but still don't leave it on the default)
